{
  "name": "pptx-sync",
  "displayName": "Presentation Folder Sync",
  "description": "Inspect, search, and one-way folder sync for PowerPoint decks. Built for vscode.dev; runs in desktop VS Code too.",
  "version": "0.1.2",
  "publisher": "sophtwhere",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jonathan-annett/pptx-viewer-ext.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "browser": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "pptxViewer.viewer",
        "displayName": "Pptx Info",
        "selector": [
          {
            "filenamePattern": "*.pptx"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "pptxViewer.pdfViewer",
        "displayName": "PDF Preview",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "folderSync.configEditor",
        "displayName": "Folder Sync configuration",
        "selector": [
          {
            "filenamePattern": ".sync.jsonc"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "folderSync.adminEditor",
        "displayName": "Folder Sync workspace snapshot",
        "selector": [
          {
            "filenamePattern": ".admin-sync.jsonc"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "folderSync.manifestEditor",
        "displayName": "Folder Sync manifest",
        "selector": [
          {
            "filenamePattern": "**/.foldersync-manifest.json"
          }
        ],
        "priority": "default"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "**/.sync.jsonc",
        "url": "./schemas/sync.schema.json"
      }
    ],
    "commands": [
      {
        "command": "folderSync.showTopology",
        "title": "Folder Sync: Show Topology",
        "category": "Folder Sync"
      },
      {
        "command": "folderSync.dryRunPlan",
        "title": "Folder Sync: Dry-Run Plan",
        "category": "Folder Sync"
      },
      {
        "command": "folderSync.openPlan",
        "title": "Folder Sync: Show Plan",
        "category": "Folder Sync"
      },
      {
        "command": "folderSync.syncThisFolder",
        "title": "Folder Sync: Sync This Folder",
        "category": "Folder Sync"
      },
      {
        "command": "folderSync.probeColdRead",
        "title": "Folder Sync: Probe Cold-Read (M4.6 diagnostic)",
        "category": "Folder Sync"
      },
      {
        "command": "folderSync.showSnapshot",
        "title": "Folder Sync: Show Workspace Snapshot",
        "category": "Folder Sync"
      },
      {
        "command": "folderSync.clearSnapshot",
        "title": "Folder Sync: Clear Workspace Snapshot",
        "category": "Folder Sync"
      },
      {
        "command": "folderSync.openAdminConfig",
        "title": "Folder Sync: Open Admin Config",
        "category": "Folder Sync"
      },
      {
        "command": "pptxViewer.probeUpload",
        "title": "Pptx Info: Probe Upload (M4 diagnostic)",
        "category": "Pptx Info"
      },
      {
        "command": "pptxSearch.openPanel",
        "title": "Presentation Search: Open",
        "category": "Presentation Search"
      }
    ],
    "configuration": {
      "title": "Pptx Info",
      "properties": {
        "pptxViewer.dropboxBaseUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "Override the dropbox-server base URL used by the upload-to-update flow. Leave empty to use the default `https://vscode.sophtwhere.com/dropbox`. Set to e.g. `http://127.0.0.1:3030` to point at a local dev instance. The WebSocket endpoint is derived by appending `/ws` and rewriting the scheme."
        }
      }
    },
    "menus": {
      "explorer/context": [
        {
          "command": "folderSync.syncThisFolder",
          "when": "explorerResourceIsFolder && folderSync.hasAnySource",
          "group": "7_modification@10"
        }
      ]
    }
  },
  "scripts": {
    "bundle": "node esbuild.config.js",
    "compile-web": "node esbuild.config.js",
    "watch-web": "node esbuild.config.js --watch",
    "watch": "node esbuild.config.js --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json",
    "test:parse": "node --import tsx test/parse.test.ts",
    "test:sync-jsonc": "node --import tsx test/sync-jsonc.test.ts",
    "test:sync-glob": "node --import tsx test/sync-glob.test.ts",
    "test:sync-plan": "node --import tsx test/sync-plan.test.ts",
    "test:sync-scoped-plan": "node --import tsx test/sync-scoped-plan.test.ts",
    "test:sync-planview": "node --import tsx test/sync-planview.test.ts",
    "test:sync-executor": "node --import tsx test/sync-executor.test.ts",
    "test:sync-config-editor": "node --import tsx test/sync-config-editor.test.ts",
    "test:sync-snapshot": "node --import tsx test/sync-snapshot.test.ts",
    "test:sync-admin-editor": "node --import tsx test/sync-admin-editor.test.ts",
    "test:sync-placeholder-registry": "node --import tsx test/sync-placeholder-registry.test.ts",
    "test:sync-manifest-editor-html": "node --import tsx test/sync-manifest-editor-html.test.ts",
    "test:sync-preview-context": "node --import tsx test/sync-preview-context.test.ts",
    "test:sync-warnings": "node --import tsx test/sync-warnings.test.ts",
    "test:sync-decisions": "node --import tsx test/sync-decisions.test.ts",
    "test:sync-hash-cache": "node --import tsx test/sync-hash-cache.test.ts",
    "test:sync-parse-cache": "node --import tsx test/sync-parse-cache.test.ts",
    "test:sync-misfile": "node --import tsx test/sync-misfile.test.ts",
    "test:sync-orphan-sweep": "node --import tsx test/sync-orphan-sweep.test.ts",
    "test:viewer-compare": "node --import tsx test/viewer-compare.test.ts",
    "test:viewer-render": "node --import tsx test/viewer-render.test.ts",
    "test:pdf-import": "node --import tsx test/pdf-import.test.ts",
    "test:pdf-import-layout": "node --import tsx test/pdf-import-layout.test.ts",
    "test:pdf-import-config-html": "node --import tsx test/pdf-import-config-html.test.ts",
    "test:upload-protocol": "node --import tsx test/upload-protocol.test.ts",
    "test:upload-modal-html": "node --import tsx test/upload-modal-html.test.ts",
    "test:pptx-title-extract": "node --import tsx test/pptx-title-extract.test.ts",
    "test:thumbnail-synth": "node --import tsx test/thumbnail-synth.test.ts",
    "test:search-fold": "node --import tsx test/search-fold.test.ts",
    "test:search-tokenize": "node --import tsx test/search-tokenize.test.ts",
    "test:search-score": "node --import tsx test/search-score.test.ts",
    "test:search-projection": "node --import tsx test/search-projection.test.ts",
    "test:search-engine": "node --import tsx test/search-engine.test.ts",
    "test:search-scope": "node --import tsx test/search-scope.test.ts",
    "test:search-panel-html": "node --import tsx test/search-panel-html.test.ts",
    "test:pptx-first-visible-slide-text": "node --import tsx test/pptx-first-visible-slide-text.test.ts",
    "package": "node --require ./scripts/fix-cpus.cjs ./node_modules/@vscode/vsce/vsce package --allow-missing-repository",
    "publish:web": "node scripts/publish-web.cjs",
    "open-in-browser": "node --require ./scripts/fix-platform.cjs --require ./scripts/fix-koa-proxy.cjs ./node_modules/@vscode/test-web/out/server/index.js --browserType=none --extensionDevelopmentPath=. --port=3001"
  },
  "webPublish": {
    "repo": "jonathan-annett/jonathan-annett.github.io",
    "branch": "main",
    "folder": "vscode-ext-dev/pptx-viewer-ext"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "jsonc-parser": "^3.3.1",
    "pdfjs-dist": "^5.7.284"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-web": "^0.0.80",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
